#!/usr/bin/make -f
# debian/rules for zypper-declarative (C++17, CMake, dynamic linking).
# X-PCD-Spec-SHA256: aafbb3158415b5c82fe459a26d0d21cbd39a077f689d5fdfb998bf5f947350a3

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_build:
	cmake --build build -j
	pandoc zypper-declarative.1.md -s -t man -o zypper-declarative.1

override_dh_auto_install:
	install -D -m 0755 build/zypper-declarative \
	    debian/zypper-declarative/usr/bin/zypper-declarative
	install -D -m 0755 build/zypper-declarative \
	    debian/zypper-declarative/usr/lib/zypper/commands/zypper-declarative
	install -D -m 0644 zypper-declarative.1 \
	    debian/zypper-declarative/usr/share/man/man1/zypper-declarative.1

override_dh_auto_test:
	# Black-box suite requires the binary at the project root; skipped in the
	# packaging build (run via `make test` during development).
