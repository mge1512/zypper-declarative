#!/usr/bin/make -f
# generated from spec: zypper-declarative.spec.md sha256:aafbb3158415b5c82fe459a26d0d21cbd39a077f689d5fdfb998bf5f947350a3

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_build:
	cmake --build build -j
	pandoc zypper-declarative.1.md -s -t man -o zypper-declarative.1

override_dh_auto_install:
	install -D -m0755 build/zypper-declarative \
	    debian/zypper-declarative/usr/lib/zypper/commands/zypper-declarative
	install -D -m0644 zypper-declarative.1 \
	    debian/zypper-declarative/usr/share/man/man1/zypper-declarative.1

override_dh_auto_test:
	# Black-box tests require a live rpmdb/snapper target; run on-target.
