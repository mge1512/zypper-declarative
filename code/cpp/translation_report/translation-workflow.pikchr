# translation-workflow.pikchr
# Auxiliary artefact: a pikchr diagram of the translation workflow for
# zypper-declarative (C++ / cli-tool). Renders with the pikchr processor.

box "spec" "zypper-declarative.spec.md" fit
arrow right
box "cli-tool" "template" fit
arrow right
box "C++ hints" "(milestones," "decisions)" fit

arrow down from last box.s
box "Phase 1" "tests first" "independent_tests/" "claude-opus-4-8/" fit
arrow down
box "Phase 2" "src/*.cpp,.hpp" "CMakeLists.txt" fit
arrow down
box "Phase 3" "Makefile, RPM," "debian/*, LICENSE" fit
arrow down
box "Phase 6" "compile gate:" "cmake build + make test" fit
arrow down
box "Phase 7" "TRANSLATION_REPORT.md" fit
