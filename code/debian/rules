#!/usr/bin/make -f
# X-PCD-Spec-SHA256: b2d0de88fbed1163678e59e931c741b9d999b71f902f6eb01db8790bb813d057

export CGO_ENABLED := 0

%:
	dh $@

override_dh_auto_build:
	go build -mod=vendor -o zypper-declarative ./cmd/zypper-declarative
	pandoc zypper-declarative.1.md -s -t man -o zypper-declarative.1

override_dh_auto_install:
	install -D -m 0755 zypper-declarative debian/zypper-declarative/usr/bin/zypper-declarative
	install -d debian/zypper-declarative/usr/lib/zypper/commands
	ln -sf /usr/bin/zypper-declarative debian/zypper-declarative/usr/lib/zypper/commands/zypper-declarative
	install -D -m 0644 zypper-declarative.1 debian/zypper-declarative/usr/share/man/man1/zypper-declarative.1

override_dh_auto_test:
	go test ./independent_tests/claude-opus-4-8/...
