#!/usr/bin/make -f
# debian/rules for zypper-declarative
# pcd-spec-sha256: f8ff76ecbc4bbc69a49e2e32b2924da3a64df1ad46196e05ce8c137b684429b2

export DH_GOPKG := github.com/mge1512/zypper-declarative
export CGO_ENABLED := 0

%:
	dh $@

override_dh_auto_build:
	go build -mod=vendor -o zypper-declarative ./cmd/zypper-declarative
	pandoc zypper-declarative.1.md -s -t man -o zypper-declarative.1

override_dh_auto_install:
	install -D -m 0755 zypper-declarative \
	    debian/zypper-declarative/usr/bin/zypper-declarative
	install -d debian/zypper-declarative/usr/lib/zypper/commands
	ln -sf /usr/bin/zypper-declarative \
	    debian/zypper-declarative/usr/lib/zypper/commands/zypper-declarative
	install -D -m 0644 zypper-declarative.1 \
	    debian/zypper-declarative/usr/share/man/man1/zypper-declarative.1

override_dh_auto_test:
	# Tests require live system tooling (rpm, systemctl) and privilege for
	# convergence paths; the non-privileged subset runs in CI.
	true
