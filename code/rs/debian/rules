#!/usr/bin/make -f
# generated from spec: zypper-declarative.spec.md sha256:87b9f2f3bf92afd6fe037412d56a23959290e5816d722a3def9505d07aa5acd7

export DH_VERBOSE = 1
BINARY := zypper-declarative
TARGET := x86_64-unknown-linux-gnu

%:
	dh $@

override_dh_auto_build:
	cargo build --release --offline
	pandoc $(BINARY).1.md -s -t man -o $(BINARY).1

override_dh_auto_install:
	install -D -m 0755 target/$(TARGET)/release/$(BINARY) \
	    debian/$(BINARY)/usr/bin/$(BINARY)
	install -D -m 0755 target/$(TARGET)/release/$(BINARY) \
	    debian/$(BINARY)/usr/lib/zypper/commands/$(BINARY)
	install -D -m 0644 $(BINARY).1 \
	    debian/$(BINARY)/usr/share/man/man1/$(BINARY).1

override_dh_auto_test:
	# Tests run via the project Makefile in CI; skipped in the package build to
	# avoid requiring the test toolchain in the buildd environment.
	true
