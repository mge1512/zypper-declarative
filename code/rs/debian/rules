#!/usr/bin/make -f
# debian/rules for zypper-declarative
# X-PCD-Spec-SHA256: 51284526723dc9238113984023bfb9a596d55b534c8ea580dfac1157cd70dd03

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	cargo build --release --offline
	cp target/x86_64-unknown-linux-gnu/release/zypper-declarative ./zypper-declarative
	pandoc zypper-declarative.1.md -s -t man -o zypper-declarative.1

override_dh_auto_install:
	install -D -m 0755 ./zypper-declarative \
	    debian/zypper-declarative/usr/bin/zypper-declarative
	install -D -m 0644 zypper-declarative.1 \
	    debian/zypper-declarative/usr/share/man/man1/zypper-declarative.1
	install -d debian/zypper-declarative/usr/lib/zypper/commands
	ln -sf /usr/bin/zypper-declarative \
	    debian/zypper-declarative/usr/lib/zypper/commands/zypper-declarative

override_dh_auto_test:
	cargo test --test '*' --manifest-path independent_tests/claude-opus-4-8/Cargo.toml

override_dh_auto_clean:
	cargo clean
	rm -f ./zypper-declarative zypper-declarative.1
